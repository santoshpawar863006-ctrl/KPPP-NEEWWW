{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "karnataka-tender-intelligence",
  "main": "./worker/claude.js",
  "compatibility_date": "2026-08-12",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/tenders.json",
      "/health.json"
    ]
  },
  "observability": {
    "enabled": true
  }
}
